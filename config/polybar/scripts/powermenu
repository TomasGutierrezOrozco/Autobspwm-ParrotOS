#!/bin/bash


rofi_command="rofi -theme $HOME/.config/polybar/scripts/themes/powermenu.rasi"

uptime=$(uptime -p | sed -e 's/up //g')

# Options
shutdown=" Shutdown"
reboot=" Restart"
lock=" Lock"
suspend=" Sleep"
logout=" Logout"

# Variable passed to rofi
options="$lock\n$suspend\n$logout\n$reboot\n$shutdown"

chosen="$(echo -e "$options" | $rofi_command -p "UP - $uptime" -dmenu -selected-row 0)"
case $chosen in
    $shutdown)
        systemctl poweroff
        ;;
    $reboot)
        systemctl reboot
        ;;
    $lock)
        if command -v i3lock-fancy >/dev/null 2>&1; then
            i3lock-fancy
        else
            i3lock
        fi
        ;;
    $suspend)
        mpc -q pause 2>/dev/null || true
        amixer set Master mute 2>/dev/null || true
        systemctl suspend
        ;;
    $logout)
        bspc quit
        ;;
esac

