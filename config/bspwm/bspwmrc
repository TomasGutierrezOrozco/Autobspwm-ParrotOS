#!/bin/sh

# Lanzar sxhkd si no está corriendo
pgrep -x sxhkd > /dev/null || sxhkd &

# Layout de monitores: extendido por defecto si hay pantalla externa
[ -x "$HOME/.config/bspwm/scripts/monitor_layout.sh" ] && "$HOME/.config/bspwm/scripts/monitor_layout.sh" extend

# Obtener nombres de los monitores de forma dinámica
INTERNAL=$(xrandr 2>/dev/null | awk '/ connected primary/{print $1; exit}')
[ -z "$INTERNAL" ] && INTERNAL=$(xrandr 2>/dev/null | awk '/ connected/{print $1; exit}')
EXTERNAL=$(xrandr 2>/dev/null | awk '/ connected/{print $1}' | grep -v "$INTERNAL" | head -n1)

# Escritorios dinámicos
if [ -n "$EXTERNAL" ] && [ -n "$INTERNAL" ]; then
    bspc monitor "$EXTERNAL" -d I II III IV V
    bspc monitor "$INTERNAL" -d VI VII VIII IX X
else
    bspc monitor "${INTERNAL:-$(bspc query -M 2>/dev/null | head -n1)}" -d I II III IV V VI VII VIII IX X
fi

# Configuración básica de bspwm
bspc config border_width         2
bspc config window_gap          12

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# Reglas de ventanas
bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

# Tema oscuro
pkill xsettingsd 2>/dev/null
xsettingsd -c "$HOME/.config/xsettingsd/xsettingsd.conf" &

# Cursor personalizado
xrdb -merge ~/.Xresources
xsetroot -cursor_name left_ptr

# Fondo de pantalla
/usr/bin/feh --bg-fill "$HOME/.config/wallpapers/Fondo6.jpg" &

# Polybar
"$HOME/.config/polybar/launch2.sh" &

# Compositor (con reinicio limpio)
killall -q picom
while pgrep -u $UID -x picom >/dev/null; do sleep 0.1; done
picom &

# Gestor de energía para portátil
pgrep -f mate-power-manager >/dev/null || mate-power-manager &

# Demonio de notificaciones (Dunst prioritario sobre MATE)
if command -v dunst >/dev/null 2>&1; then
    killall -9 mate-notification-daemon 2>/dev/null
    systemctl --user restart dunst.service 2>/dev/null || { killall -q dunst; dunst & }
fi

# Borde a 0 (si no quieres bordes en ventanas)
bspc config border_width 0

# Touchpad: Soporte hibrido (synaptics y libinput)
(
    sleep 1
    if command -v synclient >/dev/null 2>&1 && synclient -l >/dev/null 2>&1; then
        synclient TouchpadOff=0 \
                  TapButton1=1 TapButton2=3 TapButton3=2 \
                  ClickFinger1=1 ClickFinger2=3 ClickFinger3=2 \
                  MaxTapTime=180 \
                  PalmDetect=1 PalmMinWidth=5 PalmMinZ=40 \
                  VertTwoFingerScroll=1
    elif command -v xinput >/dev/null 2>&1; then
        # Activar toque para hacer clic (tapping) y scroll natural en libinput
        for id in $(xinput list --id-only 2>/dev/null); do
            props=$(xinput list-props "$id" 2>/dev/null || true)
            if echo "$props" | grep -qi "libinput Tapping Enabled"; then
                xinput set-prop "$id" "libinput Tapping Enabled" 1 2>/dev/null || true
                xinput set-prop "$id" "libinput Natural Scrolling Enabled" 0 2>/dev/null || true
            fi
        done
    fi
) &

# Fix para aplicaciones Java
command -v wmname >/dev/null 2>&1 && wmname LG3D &
